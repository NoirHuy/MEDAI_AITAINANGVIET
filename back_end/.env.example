# =============================================================================
# MedChat Backend — Environment Variables
# Copy this file to .env and fill in real values before running.
# NEVER commit .env to Git — it is gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# 🌐 SERVER
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=production

# Frontend origin allowed to call this API with credentials
# Dev:  http://localhost:5173
# Prod: https://your-domain.example.com
CLIENT_ORIGIN=http://localhost:5173

# Whether to set the Secure flag on session cookies (must be true on HTTPS)
COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# 🔐 SECURITY
# -----------------------------------------------------------------------------
# Long random string used to sign JWTs — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-long-random-jwt-secret-here

# AES-256 encryption key for personal memory data — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEMORY_ENCRYPTION_KEY=your-32-byte-hex-memory-encryption-key-here

# -----------------------------------------------------------------------------
# 🤖 AI — 9Router (LLM Gateway)
# -----------------------------------------------------------------------------
NINEROUTER_API=your-9router-api-key-here
# Docker internal: http://ninerouter:20128/v1
# Local (outside Docker): http://127.0.0.1:20128/v1
NINEROUTER_URL=http://ninerouter:20128/v1

# Model used for main chat replies
OPENROUTER_MODEL_CHAT=gemini/gemini-3.1-flash-lite-preview
# Model used for NER / memory extraction (background, can be slower)
OPENROUTER_MODEL_NER=gemini/gemini-3.1-flash-lite-preview
# Legacy fallback model alias
OPENROUTER_MODEL=gemini/gemini-3.1-flash-lite-preview

# -----------------------------------------------------------------------------
# 🔑 THIRD-PARTY SERVICES
# -----------------------------------------------------------------------------
# UMLS Metathesaurus API — https://uts.nlm.nih.gov/uts/signup-login
UMLS_API_KEY=your-umls-api-key-here

# Google OAuth 2.0 Client ID — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# 🗄️ MONGODB
# -----------------------------------------------------------------------------
# Docker internal: mongodb://mongodb:27017/medchat
# Local (outside Docker): mongodb://127.0.0.1:27018/medchat
MONGODB_URI=mongodb://mongodb:27017/medchat

# -----------------------------------------------------------------------------
# 🕸️ NEO4J GRAPH DATABASE
# -----------------------------------------------------------------------------
# Docker internal: bolt://neo4j:7687
# Local (outside Docker): bolt://127.0.0.1:7687
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
NEO4J_DATABASE=neo4j

# -----------------------------------------------------------------------------
# 💳 PAYMENTS — Stripe
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here

# -----------------------------------------------------------------------------
# 💳 PAYMENTS — PayOS (Vietnamese payment gateway)
# -----------------------------------------------------------------------------
PAYOS_CLIENT_ID=your-payos-client-id-here
PAYOS_API_KEY=your-payos-api-key-here
PAYOS_CHECKSUM_KEY=your-payos-checksum-key-here

# -----------------------------------------------------------------------------
# 👤 ADMIN
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@your-domain.example.com

# -----------------------------------------------------------------------------
# ⚙️ GRAPHRAG SCORING WEIGHTS (optional — defaults shown)
# -----------------------------------------------------------------------------
# W_CHIEF_COMPLAINT=1.5
# W_ASSOCIATED=1.0
# PENALTY_MULTIPLIER=0.8
# CONFIDENCE_THRESHOLD=0.7

# -----------------------------------------------------------------------------
# 🧠 MEMORY SETTINGS (optional — defaults shown)
# -----------------------------------------------------------------------------
# MEMORY_MAX_PER_USER=500
# MEMORY_MIN_CONFIDENCE=0.70
# MEMORY_TOKEN_BUDGET=500
