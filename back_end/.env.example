# Port the API server listens on
PORT=4000

# Origin allowed to call this API with credentials (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign session JWTs — replace with a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# 🚀 9Router configuration for AI replies
NINEROUTER_API=sk-aa5b72eb6a1e250a-2ht8wi-6560c27d
NINEROUTER_URL=http://ninerouter:20128/v1
OPENROUTER_MODEL=gemini/gemini-3.1-flash-lite-preview
OPENROUTER_MODEL_NER=gemini/gemini-3.1-flash-lite-preview
OPENROUTER_MODEL_CHAT=gemini/gemini-3.1-flash-lite-preview
UMLS_API_KEY=

# Google OAuth Client ID
GOOGLE_CLIENT_ID=

# Cookie Secure flag for HTTPS
COOKIE_SECURE=false

# Neo4j Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
