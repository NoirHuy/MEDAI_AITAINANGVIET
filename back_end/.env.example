# Port the API server listens on
PORT=4000

# Origin allowed to call this API with credentials (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Secret used to sign session JWTs — replace with a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# Optional: enables real AI replies via the Anthropic API instead of the
# built-in mock reply generator. Leave unset to keep using the mock.
ANTHROPIC_API_KEY=

# Optional: enables real "Sign in with Google" verification instead of the
# demo Google-picker fallback. Must be the SAME OAuth 2.0 Web Client ID as
# VITE_GOOGLE_CLIENT_ID in the frontend's .env (it's the "audience" the
# token is checked against). Get one at
# https://console.cloud.google.com/apis/credentials — create an
# "OAuth client ID" of type "Web application" and add
# http://localhost:5173 under "Authorized JavaScript origins" (no redirect
# URI needed for this flow). Leave unset to keep using the mock.
GOOGLE_CLIENT_ID=

# Set to "true" once this is served over HTTPS so the session cookie gets
# the Secure flag. Keep "false" for local http:// development.
COOKIE_SECURE=false
