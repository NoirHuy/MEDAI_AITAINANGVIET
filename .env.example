VITE_API_URL=http://localhost:4000

# Optional: enables the real "Sign in with Google" button instead of the
# demo Google-picker fallback. Must match GOOGLE_CLIENT_ID in
# back_end/.env. Get one at https://console.cloud.google.com/apis/credentials
# (OAuth client ID -> Web application -> add http://localhost:5173 under
# "Authorized JavaScript origins"). Leave unset to keep using the mock.
VITE_GOOGLE_CLIENT_ID=

# Production VPS domain (used by docker-compose.prod.yml + Caddyfile for
# automatic HTTPS). Not used by `npm run dev`. Leave as-is until deploying.
DOMAIN=your-domain.example.com
